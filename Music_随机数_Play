package com.example.myapplication;

import androidx.appcompat.app.AppCompatActivity;

import android.content.SharedPreferences;
import android.media.AudioFormat;
import android.media.AudioManager;
import android.media.AudioTrack;
import android.os.Bundle;
import android.util.Log;
import android.view.WindowManager;
import android.widget.Button;
import android.widget.CheckBox;
import android.widget.EditText;
import android.widget.TextView;
import java.math.BigInteger;


import java.util.Random;
import java.util.concurrent.LinkedBlockingQueue;

public class MainActivity extends AppCompatActivity {

    private static final String TAG = "PiSound";
    private static final String PREF_NAME = "PiStatePrefs";
    private static final int SAMPLE_RATE = 44100;
    
    private static final double[] FREQUENCIES = {
        261.63, 293.66, 329.63, 349.23, 392.00, 
        440.00, 493.88, 523.25, 587.33, 659.25 
    };
    
    private static final double DURATION = 0.31415926;

    private volatile boolean isPlaying = false;
    private Thread playThread;
    private Thread calcThread;
    private PiGenerator piGenerator;
    private final LinkedBlockingQueue<Integer> digitQueue = new LinkedBlockingQueue<>(100);
    
    private Button btnStart, btnPause, btnResume, btnRestart;
    private TextView tvCurrentDigit;
    private EditText etGapDigit, etGapMin, etGapMax;
    private CheckBox cbRandomGap;
    private final Random random = new Random();

    private final short[] silenceBuffer = new short[SAMPLE_RATE]; 

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        getWindow().addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON);
        setContentView(R.layout.activity_main);

        btnStart = findViewById(R.id.btn_start);
        btnPause = findViewById(R.id.btn_pause);
        btnResume = findViewById(R.id.btn_resume);
        btnRestart = findViewById(R.id.btn_restart);
        tvCurrentDigit = findViewById(R.id.tv_current_digit);
        etGapDigit = findViewById(R.id.et_gap_digit);
        etGapMin = findViewById(R.id.et_gap_min);
        etGapMax = findViewById(R.id.et_gap_max);
        cbRandomGap = findViewById(R.id.cb_random_gap);

        loadSavedState();

        btnStart.setOnClickListener(v -> {
            if (!isPlaying) startPlayback();
            else stopPlayback();
        });

        btnPause.setOnClickListener(v -> pausePlayback());
        btnResume.setOnClickListener(v -> resumePlayback());
        btnRestart.setOnClickListener(v -> resetAndStart());
    }

    private void startPlayback() {
        isPlaying = true;
        btnStart.setText("停止程序");
        btnPause.setEnabled(true);
        btnResume.setEnabled(false);
        startEngine();
    }

    private void stopPlayback() {
        isPlaying = false;
        if (playThread != null) playThread.interrupt();
        if (calcThread != null) calcThread.interrupt();
        btnStart.setText("启动程序");
        btnPause.setEnabled(false);
        btnResume.setEnabled(false);
    }

    private void pausePlayback() {
        isPlaying = false;
        if (playThread != null) playThread.interrupt();
        if (calcThread != null) calcThread.interrupt();
        btnPause.setEnabled(false);
        btnResume.setEnabled(true);
        btnStart.setText("启动程序");
    }

    private void resumePlayback() {
        isPlaying = true;
        btnPause.setEnabled(true);
        btnResume.setEnabled(false);
        btnStart.setText("停止程序");
        startEngine();
    }

    private void resetAndStart() {
        isPlaying = false;
        if (playThread != null) playThread.interrupt();
        if (calcThread != null) calcThread.interrupt();
        digitQueue.clear();
        clearSavedState();
        piGenerator = null;
        tvCurrentDigit.setText("计算中...");
        isPlaying = true;
        btnStart.setText("停止程序");
        btnPause.setEnabled(true);
        btnResume.setEnabled(false);
        startEngine();
    }

    private void startEngine() {
        if (piGenerator == null) {
            piGenerator = new PiGenerator();
            piGenerator.nextDigit();
        }

        calcThread = new Thread(() -> {
            try {
                while (!Thread.currentThread().isInterrupted()) {
                    int digit = piGenerator.nextDigit();
                    digitQueue.put(digit);
                }
            } catch (InterruptedException ignored) {}
        });
        calcThread.start();

        playThread = new Thread(() -> {
            AudioTrack audioTrack = null;
            try {
                int minBufSize = AudioTrack.getMinBufferSize(SAMPLE_RATE, 
                        AudioFormat.CHANNEL_OUT_MONO, AudioFormat.ENCODING_PCM_16BIT);
                
                audioTrack = new AudioTrack(
                        AudioManager.STREAM_MUSIC,
                        SAMPLE_RATE,
                        AudioFormat.CHANNEL_OUT_MONO,
                        AudioFormat.ENCODING_PCM_16BIT,
                        Math.max(minBufSize, SAMPLE_RATE), 
                        AudioTrack.MODE_STREAM);

                audioTrack.play();

                while (isPlaying && !Thread.currentThread().isInterrupted()) {
                    Integer digit = digitQueue.take();
                    
                    saveCurrentState(digit);
                    final String digitStr = String.valueOf(digit);
                    runOnUiThread(() -> tvCurrentDigit.setText(digitStr));

                    playWaveToTrack(audioTrack, DURATION, FREQUENCIES[digit]);
                    
                    if (isPlaying) {
                        long gapMicro = 500000;
                        if (cbRandomGap.isChecked()) {
                            try {
                                long min = Long.parseLong(etGapMin.getText().toString());
                                long max = Long.parseLong(etGapMax.getText().toString());
                                if (max > min) {
                                    gapMicro = min + (Math.abs(random.nextLong()) % (max - min + 1));
                                } else {
                                    gapMicro = min;
                                }
                            } catch (Exception ignored) {}
                        } else {
                            try {
                                gapMicro = Long.parseLong(etGapDigit.getText().toString());
                            } catch (Exception ignored) {}
                        }
                        
                        playSilenceToTrack(audioTrack, gapMicro);
                    }
                }
            } catch (InterruptedException e) {
                Log.d(TAG, "线程中断");
            } catch (Exception e) {
                Log.e(TAG, "运行错误", e);
            } finally {
                if (audioTrack != null) {
                    try { audioTrack.stop(); audioTrack.release(); } catch (Exception ignored) {}
                }
            }
        });
        playThread.start();
    }

    private void playWaveToTrack(AudioTrack track, double duration, double freq) {
        int numSamples = (int) (duration * SAMPLE_RATE);
        short[] buffer = new short[numSamples];
        int fadeSamples = (int) (0.040 * SAMPLE_RATE); 
        fadeSamples = Math.min(fadeSamples, numSamples / 2);
        
        for (int i = 0; i < numSamples; i++) {
            double angle = 2.0 * Math.PI * freq * i / SAMPLE_RATE;
            double sampleValue = Math.sin(angle);
            double envelope = 1.0;
            if (i < fadeSamples) {
                envelope = (double) i / fadeSamples;
            } else if (i > numSamples - fadeSamples) {
                envelope = (double) (numSamples - 1 - i) / fadeSamples;
            }
            buffer[i] = (short) (sampleValue * envelope * 25000);
        }
        track.write(buffer, 0, buffer.length);
    }

    private void playSilenceToTrack(AudioTrack track, long gapMicro) {
        gapMicro = Math.min(gapMicro, 10000000L);
        int totalSamples = (int) ((gapMicro / 1000000.0) * SAMPLE_RATE);
        if (totalSamples <= 0) return;
        
        int written = 0;
        while (written < totalSamples && isPlaying) {
            int toWrite = Math.min(totalSamples - written, silenceBuffer.length);
            track.write(silenceBuffer, 0, toWrite);
            written += toWrite;
        }
    }

    private void saveCurrentState(int lastDigit) {
        SharedPreferences.Editor editor = getSharedPreferences(PREF_NAME, MODE_PRIVATE).edit();
        editor.putString("q", piGenerator.q.toString());
        editor.putString("r", piGenerator.r.toString());
        editor.putString("t", piGenerator.t.toString());
        editor.putString("k", piGenerator.k.toString());
        editor.putString("n", piGenerator.n.toString());
        editor.putString("l", piGenerator.l.toString());
        editor.putString("lastDigit", String.valueOf(lastDigit));
        editor.apply();
    }

    private void loadSavedState() {
        SharedPreferences prefs = getSharedPreferences(PREF_NAME, MODE_PRIVATE);
        String qStr = prefs.getString("q", null);
        if (qStr != null) {
            try {
                piGenerator = new PiGenerator();
                piGenerator.q = new BigInteger(qStr);
                piGenerator.r = new BigInteger(prefs.getString("r", "0"));
                piGenerator.t = new BigInteger(prefs.getString("t", "1"));
                piGenerator.k = new BigInteger(prefs.getString("k", "1"));
                piGenerator.n = new BigInteger(prefs.getString("n", "3"));
                piGenerator.l = new BigInteger(prefs.getString("l", "3"));
                String lastDigit = prefs.getString("lastDigit", "-");
                tvCurrentDigit.setText(lastDigit);
                btnResume.setEnabled(true);
            } catch (Exception e) {
                piGenerator = null;
            }
        }
    }

    private void clearSavedState() {
        getSharedPreferences(PREF_NAME, MODE_PRIVATE).edit().clear().apply();
    }

    private static class PiGenerator {
        BigInteger q = BigInteger.ONE, r = BigInteger.ZERO, t = BigInteger.ONE, 
                   k = BigInteger.ONE, n = BigInteger.valueOf(3), l = BigInteger.valueOf(3);

        public int nextDigit() {
            while (true) {
                if (q.multiply(BigInteger.valueOf(4)).add(r).subtract(t).compareTo(n.multiply(t)) < 0) {
                    int digit = n.intValue();
                    BigInteger nr = BigInteger.valueOf(10).multiply(r.subtract(n.multiply(t)));
                    n = BigInteger.valueOf(10).multiply(BigInteger.valueOf(3).multiply(q).add(r)).divide(t).subtract(BigInteger.valueOf(10).multiply(n));
                    q = q.multiply(BigInteger.valueOf(10));
                    r = nr;
                    return digit;
                } else {
                    BigInteger nr = BigInteger.valueOf(2).multiply(q).add(r).multiply(l);
                    BigInteger nn = q.multiply(BigInteger.valueOf(7).multiply(k).add(BigInteger.valueOf(2))).add(r.multiply(l)).divide(t.multiply(l));
                    q = q.multiply(k);
                    t = t.multiply(l);
                    l = l.add(BigInteger.valueOf(2));
                    k = k.add(BigInteger.ONE);
                    n = nn;
                    r = nr;
                }
            }
        }
    }
}
