    private void setupSpinners() {
        if (spInstrument != null) {
            ArrayAdapter<CharSequence> adapter = ArrayAdapter.createFromResource(this,
                    R.array.instrument_names, android.R.layout.simple_spinner_item);
            adapter.setDropDownViewResource(android.R.layout.simple_spinner_dropdown_item);
            spInstrument.setAdapter(adapter);
        }
        if (spRhythm != null) {
            ArrayAdapter<CharSequence> adapter = ArrayAdapter.createFromResource(this,
                    R.array.rhythm_names, android.R.layout.simple_spinner_item);
            adapter.setDropDownViewResource(android.R.layout.simple_spinner_dropdown_item);
            spRhythm.setAdapter(adapter);
        }
    }

    private void setupLanguageSwitcher() {
        if (spLanguage != null) {
            ArrayAdapter<CharSequence> adapter = ArrayAdapter.createFromResource(this,
                    R.array.language_names, android.R.layout.simple_spinner_item);
            adapter.setDropDownViewResource(android.R.layout.simple_spinner_dropdown_item);
            spLanguage.setAdapter(adapter);

            String currentLang = AppCompatDelegate.getApplicationLocales().toLanguageTags();
            spLanguage.setSelection(currentLang.contains("en") ? 1 : 0);

            spLanguage.post(() -> spLanguage.setOnItemSelectedListener(new android.widget.AdapterView.OnItemSelectedListener() {
                @Override
                public void onItemSelected(android.widget.AdapterView<?> parent, android.view.View view, int position, long id) {
                    String targetLang = (position == 1) ? "en" : "zh";
                    if (!AppCompatDelegate.getApplicationLocales().toLanguageTags().contains(targetLang)) {
                        AppCompatDelegate.setApplicationLocales(LocaleListCompat.forLanguageTags(targetLang));
                    }
                }
                @Override public void onNothingSelected(android.widget.AdapterView<?> p) {}
            }));
        }
    }

    private void setupModeListeners() {
        if (cbSyllableMode != null && cbRandomMapping != null) {
            TextView tvRhythmLabel = findViewById(R.id.tv_rhythm_label);
            boolean isSyllable = cbSyllableMode.isChecked();
            cbRandomMapping.setEnabled(isSyllable);
            if (spRhythm != null) spRhythm.setEnabled(isSyllable);
            if (tvRhythmLabel != null) tvRhythmLabel.setEnabled(isSyllable);

            cbSyllableMode.setOnCheckedChangeListener((buttonView, isChecked) -> {
                cbRandomMapping.setEnabled(isChecked);
                if (spRhythm != null) spRhythm.setEnabled(isChecked);
                if (tvRhythmLabel != null) tvRhythmLabel.setEnabled(isChecked);
                if (!isChecked) cbRandomMapping.setChecked(false);
            });
        }
    }

    private void setupGapListeners() {
        if (cbRandomGap != null) {
            TextView tvGapLabel = findViewById(R.id.tv_gap_label);
            TextView tvMinLabel = findViewById(R.id.tv_random_gap_min_label);
            TextView tvMaxLabel = findViewById(R.id.tv_random_gap_max_label);
            boolean initial = cbRandomGap.isChecked();
            if (etGapDigit != null) etGapDigit.setEnabled(!initial);
            if (tvGapLabel != null) tvGapLabel.setEnabled(!initial);
            if (etRandomGapMin != null) etRandomGapMin.setEnabled(initial);
            if (etRandomGapMax != null) etRandomGapMax.setEnabled(initial);
            if (tvMinLabel != null) tvMinLabel.setEnabled(initial);
            if (tvMaxLabel != null) tvMaxLabel.setEnabled(initial);

            cbRandomGap.setOnCheckedChangeListener((v, isChecked) -> {
                if (etGapDigit != null) etGapDigit.setEnabled(!isChecked);
                if (tvGapLabel != null) tvGapLabel.setEnabled(!isChecked);
                if (etRandomGapMin != null) etRandomGapMin.setEnabled(isChecked);
                if (etRandomGapMax != null) etRandomGapMax.setEnabled(isChecked);
                if (tvMinLabel != null) tvMinLabel.setEnabled(isChecked);
                if (tvMaxLabel != null) tvMaxLabel.setEnabled(isChecked);
            });
        }
    }

    private void togglePlayback() {
        if (!isPlaying) startPlayback();
        else stopPlayback();
    }

    private void startPlayback() {
        isPlaying = true;
        if (piFileReader == null) {
            piFileReader = new PiFileReader(getResources());
        }
        updateMapping();
        if (btnStart != null) btnStart.setText(R.string.stop_program);
        if (btnPause != null) btnPause.setEnabled(true);
        if (btnResume != null) btnResume.setEnabled(false);
        startPiThread();
    }

    private void stopPlayback() {
        isPlaying = false;
        if (playThread != null) playThread.interrupt();
        saveCurrentState(true);
        if (btnStart != null) btnStart.setText(R.string.start_program);
        if (btnPause != null) btnPause.setEnabled(false);
        if (btnResume != null) btnResume.setEnabled(false);
    }

    private void pausePlayback() {
        isPlaying = false;
        if (playThread != null) playThread.interrupt();
        saveCurrentState(true);
        if (btnPause != null) btnPause.setEnabled(false);
        if (btnResume != null) btnResume.setEnabled(true);
        if (btnStart != null) btnStart.setText(R.string.start_program);
    }

    private void resumePlayback() {
        isPlaying = true;
        if (btnPause != null) btnPause.setEnabled(true);
        if (btnResume != null) btnResume.setEnabled(false);
        if (btnStart != null) btnStart.setText(R.string.stop_program);
        startPiThread();
    }

    private void resetAndStart() {
        stopPlayback();
        if (piFileReader != null) piFileReader.reset();
        clearSavedState();
        if (tvCurrentDigit != null) tvCurrentDigit.setText(R.string.calculating);
        startPlayback();
    }

    private void jumpToPosition() {
        if (etJumpIndex == null) return;
        try {
            long targetIndex = Long.parseLong(etJumpIndex.getText().toString().trim());
            if (targetIndex < 0) return;
            
            boolean wasPlaying = isPlaying;
            stopPlayback();
            
            new Thread(() -> {
                if (piFileReader == null) piFileReader = new PiFileReader(getResources());
                piFileReader.jumpToIndex(targetIndex);
                runOnUiThread(() -> {
                    updateIndexDisplay(targetIndex);
                    Toast.makeText(this, "Jumped to " + targetIndex, Toast.LENGTH_SHORT).show();
                    if (wasPlaying) startPlayback();
                });
            }).start();
        } catch (Exception e) {
            Toast.makeText(this, "Invalid Index", Toast.LENGTH_SHORT).show();
        }
    }

    private void startPiThread() {
        if (playThread != null && playThread.isAlive()) playThread.interrupt();

        final int instrumentIndex = spInstrument != null ? spInstrument.getSelectedItemPosition() : 0;
        final int rhythmIndex = spRhythm != null ? spRhythm.getSelectedItemPosition() : 0;
        final boolean isSyllableMode = cbSyllableMode != null && cbSyllableMode.isChecked();
        final double durLong = parseDoubleSafely(etDurationLong, 0.31415);
        final double durShort = parseDoubleSafely(etDurationShort, 0.1200);
        final double gapBit = parseDoubleSafely(etGapBit, 0.0741);
        final long syllableGapBase = (long) parseDoubleSafely(etSyllableGap, 100);
        final long syllableRandMin = (long) parseDoubleSafely(etSyllableRandomGapMin, 200);
        final long syllableRandMax = (long) parseDoubleSafely(etSyllableRandomGapMax, 300);
        final long segmentGap = (long) parseDoubleSafely(etSegmentGap, 1000);

        playThread = new Thread(() -> {
            AudioTrack audioTrack = null;
            PowerManager.WakeLock wakeLock = null;
            try {
                PowerManager pm = (PowerManager) getSystemService(POWER_SERVICE);
                if (pm != null) {
                    wakeLock = pm.newWakeLock(PowerManager.PARTIAL_WAKE_LOCK, "PiSound:CpuLock");
                    wakeLock.acquire(24 * 60 * 60 * 1000L);
                }

                if (piFileReader == null) piFileReader = new PiFileReader(getResources());

                int minBufSize = AudioTrack.getMinBufferSize(SAMPLE_RATE, AudioFormat.CHANNEL_OUT_MONO, AudioFormat.ENCODING_PCM_16BIT);
                audioTrack = new AudioTrack.Builder()
                        .setAudioAttributes(new AudioAttributes.Builder().setUsage(AudioAttributes.USAGE_MEDIA).setContentType(AudioAttributes.CONTENT_TYPE_MUSIC).build())
                        .setAudioFormat(new AudioFormat.Builder().setEncoding(AudioFormat.ENCODING_PCM_16BIT).setSampleRate(SAMPLE_RATE).setChannelMask(AudioFormat.CHANNEL_OUT_MONO).build())
                        .setBufferSizeInBytes(Math.max(minBufSize, 4096))
                        .setTransferMode(AudioTrack.MODE_STREAM)
                        .build();
                audioTrack.play();

                int noteCounter = 0;
                int cycleLen = getRhythmCycleLength(rhythmIndex);

                while (isPlaying && !Thread.currentThread().isInterrupted()) {
                    int digit = piFileReader.nextDigit();
                    if (digit == -1) break;

                    long currentIndex = piFileReader.getCurrentIndex();
                    saveCurrentState(noteCounter % 50 == 0);

                    final String digitStr = String.valueOf(digit);
                    runOnUiThread(() -> {
                        if (tvCurrentDigit != null) tvCurrentDigit.setText(digitStr);
                        updateIndexDisplay(currentIndex);
                    });

                    if (isSyllableMode) {
                        runOnUiThread(() -> { if (tvCurrentBits != null) tvCurrentBits.setText(""); });
                        int mappedIndex = activeMapping[digit % 10];
                        
                        // 动态选择音阶：只有古筝 (index 9) 使用五声音阶，其他使用七声音阶
                        double[] activeFreqs = (instrumentIndex == 9) ? PENTATONIC_FREQS : DIATONIC_FREQS;
                        double freq = activeFreqs[mappedIndex % 10];
                        
                        // [独创逻辑]：如果是“圆周维度”音色，频率会根据数字大小产生微妙的“量子偏移”
                        if (instrumentIndex == 10) {
                            freq *= (1.0 + (digit - 4.5) * 0.002); 
                        }
                        
                        double duration = getRhythmDuration(rhythmIndex, noteCounter, durLong);
                        playInstrumentWave(audioTrack, duration, instrumentIndex, freq, digit);
                        safeSleep((long) (duration * 1000));
                        
                        noteCounter++;
                        if (cycleLen > 0 && noteCounter % cycleLen == 0) {
                            if (segmentGap > 0) safeSleep(segmentGap);
                        } else {
                            long totalSyllableGap = syllableGapBase;
                            if (syllableRandMax > syllableRandMin) {
                                totalSyllableGap += syllableRandMin + random.nextInt((int) (syllableRandMax - syllableRandMin + 1));
                            } else if (syllableRandMax == syllableRandMin && syllableRandMax > 0) {
                                totalSyllableGap += syllableRandMax;
                            }
                            if (totalSyllableGap > 0) safeSleep(totalSyllableGap);
                        }
                    } else {
                        final String binStr = BINARY_MAPPING[digit % 10];
                        runOnUiThread(() -> { if (tvCurrentBits != null) tvCurrentBits.setText(binStr); });
                        for (char bit : binStr.toCharArray()) {
                            if (!isPlaying || Thread.currentThread().isInterrupted()) break;
                            double duration = (bit == '0') ? durShort : durLong;
                            // 二进制模式也支持动态音色
                            playInstrumentWave(audioTrack, duration, instrumentIndex, DEFAULT_FREQUENCY, digit);
                            safeSleep((long) (duration * 1000));
                            safeSleep((long) (gapBit * 1000));
                        }
                        if (isPlaying && !Thread.currentThread().isInterrupted()) {
                            long totalGap = parseGapTimes();
                            if (totalGap > 0) safeSleep(totalGap);
                        }
                    }
                }
            } catch (Exception e) {
                Log.e(TAG, "Runtime Error", e);
            } finally {
                if (audioTrack != null) {
                    try {
                        // 写入一小段静音作为缓冲
                        trackSilence(audioTrack, 100);
                        audioTrack.pause();
                        audioTrack.flush();
                        audioTrack.stop();
                        audioTrack.release();
                    } catch (Exception ignored) {}
                }
                if (wakeLock != null && wakeLock.isHeld()) {
                    try {
                        wakeLock.release();
                    } catch (Exception ignored) {}
                }
            }
        });
        playThread.start();
    }

    private void trackSilence(AudioTrack track, int durationMs) {
        int numSamples = (durationMs * SAMPLE_RATE) / 1000;
        if (numSamples > 0) {
            short[] silence = new short[numSamples];
            track.write(silence, 0, silence.length);
        }
    }

    private void updateIndexDisplay(long index) {
        if (tvCurrentIndex != null) {
            String label = getString(R.string.index_label);
            tvCurrentIndex.setText(label + " " + index);
        }
    }

    private double parseDoubleSafely(EditText et, double defaultValue) {
        if (et == null) return defaultValue;
        try { return Double.parseDouble(et.getText().toString().trim()); } catch (Exception e) { return defaultValue; }
    }

    private void playInstrumentWave(@NonNull AudioTrack track, double duration, int instrumentIndex, double frequency, int digit) {
        int numSamples = (int) (duration * SAMPLE_RATE);
        short[] buffer = new short[numSamples];
        for (int i = 0; i < numSamples; i++) {
            double t = (double) i / SAMPLE_RATE;
            double angle = 2.0 * Math.PI * frequency * t;
            double sample;
            switch (instrumentIndex) {
                case 1: sample = Math.sin(angle) >= 0 ? 1.0 : -1.0; break;
                case 2: sample = Math.asin(Math.sin(angle)) * (2.0 / Math.PI); break;
                case 3:
                    double v = 1.0 + 0.01 * Math.sin(2.0 * Math.PI * 5.0 * t);
                    sample = (2.0 / Math.PI) * (v * frequency * Math.PI * (t % (1.0 / (v * frequency))) - (Math.PI / 2.0));
                    break;
                case 4:
                    double decay = Math.exp(-4.0 * t / duration);
                    sample = Math.sin(angle) * decay + 0.5 * Math.sin(2 * angle) * decay * 0.5;
                    break;
                case 5:
                    double fb = frequency * 2 + 1000 * Math.sin(2 * Math.PI * 10 * t);
                    sample = Math.sin(2.0 * Math.PI * fb * t);
                    break;
                case 6:
                    double pulse = Math.sin(2 * Math.PI * 50 * t);
                    sample = (pulse > 0.9) ? Math.sin(2 * Math.PI * 8000 * t) : 0;
                    break;
                case 7:
                    double mod = 2.0 * Math.sin(2.0 * Math.PI * frequency * 2.0 * t);
                    sample = Math.sin(angle + mod) * Math.exp(-2.0 * t / duration);
                    break;
                case 8:
                    sample = 0.6 * Math.sin(angle) + 0.2 * Math.sin(angle * 0.5) + 0.2 * Math.sin(angle * 1.5);
                    if (Math.sin(angle) < 0) sample *= 0.8;
                    break;
                case 9: // 古筝 (Guzheng - 模拟丰富的琴弦谐波与扫频)
                    double guzhengDecay = Math.exp(-3.5 * t / duration);
                    // 基础频率 + 多个不均匀谐波，模拟古筝琴弦的共鸣
                    sample = 0.5 * Math.sin(angle) * guzhengDecay;
                    sample += 0.2 * Math.sin(angle * 2.001) * Math.exp(-5.0 * t / duration);
                    sample += 0.15 * Math.sin(angle * 3.002) * Math.exp(-7.0 * t / duration);
                    sample += 0.1 * Math.sin(angle * 4.003) * Math.exp(-9.0 * t / duration);
                    // 增加一点极微小的音高波动 (模拟手指拨弦瞬间)
                    double vibratoGuz = 0.002 * Math.sin(2.0 * Math.PI * 6.0 * t);
                    sample += 0.05 * Math.sin(angle * (1.0 + vibratoGuz));
                    break;
                case 10: // [独创] 圆周维度 (Pi-Dimension) - 动态音色
                    // 音色随数字大小根本性改变
                    if (digit < 3) { // 低位：深沉的正弦+三角组合 (Sub-Drone)
                        sample = 0.7 * Math.sin(angle) + 0.3 * Math.asin(Math.sin(angle * 0.5));
                    } else if (digit < 7) { // 中位：明亮的锯齿波 (Bright Saw)
                        sample = (2.0 / Math.PI) * (frequency * Math.PI * (t % (1.0 / frequency)) - (Math.PI / 2.0));
                        sample *= Math.exp(-1.0 * t / duration); // 轻微衰减
                    } else { // 高位：晶莹的调频贝尔音 (Crystal FM Bell)
                        double dynamicMod = 5.0 + digit; 
                        double fm = Math.sin(angle + dynamicMod * Math.sin(angle * 2.0));
                        sample = fm * Math.exp(-5.0 * t / duration);
                    }
                    break;
                default: sample = Math.sin(angle);
            }
            // 改进淡入淡出逻辑 (使用余弦曲线更平滑)
            // 确保起始和结束点振幅严格为 0
            int fade = Math.min(numSamples / 10, 800);
            double env = 1.0;
            if (i < fade) env = 0.5 * (1.0 - Math.cos(Math.PI * i / fade));
            else if (i > numSamples - fade) env = 0.5 * (1.0 - Math.cos(Math.PI * (numSamples - i) / fade));

            // 在极值点附近强制归零，彻底消除爆破音
            if (i == 0 || i == numSamples - 1) env = 0.0;

            buffer[i] = (short) (sample * env * 32767 * 0.7);
        }
        track.write(buffer, 0, buffer.length);
        // 不再在 playInstrumentWave 内部进行 sleep，由外部循环控制节奏
        // 以便 AudioTrack 的内部缓冲区能更连续地工作
    }

    private long parseGapTimes() {
        try {
            if (cbRandomGap != null && cbRandomGap.isChecked()) {
                long min = Long.parseLong(etRandomGapMin.getText().toString().trim());
                long max = Long.parseLong(etRandomGapMax.getText().toString().trim());
                return (max > min) ? min + random.nextInt((int)(max - min + 1)) : min;
            }
            return Long.parseLong(etGapDigit.getText().toString().trim());
        } catch (Exception e) { return 500; }
    }

    private void safeSleep(long millis) {
        try { if (millis > 0) Thread.sleep(millis); } catch (InterruptedException e) { Thread.currentThread().interrupt(); }
    }

    private void saveCurrentState(boolean force) {
        if (piFileReader == null) return;
        SharedPreferences.Editor editor = getSharedPreferences(PREF_NAME, MODE_PRIVATE).edit();
        editor.putLong("piIndex", piFileReader.getCurrentIndex());
        if (force) editor.apply(); else editor.apply(); // Simple apply for both for now
    }

    private void loadSavedState() {
        try {
            SharedPreferences prefs = getSharedPreferences(PREF_NAME, MODE_PRIVATE);
            long savedIndex = prefs.getLong("piIndex", 0);
            if (piFileReader == null) piFileReader = new PiFileReader(getResources());
            if (savedIndex > 0) piFileReader.jumpToIndex(savedIndex);
            runOnUiThread(() -> {
                updateIndexDisplay(savedIndex);
                if (btnResume != null && savedIndex > 0) btnResume.setEnabled(true);
            });
        } catch (Exception e) { Log.e(TAG, "Load State Error", e); }
    }

    private void clearSavedState() {
        getSharedPreferences(PREF_NAME, MODE_PRIVATE).edit().clear().apply();
    }

    private void updateMapping() {
        if (cbRandomMapping != null && cbRandomMapping.isChecked()) {
            for (int i = 9; i > 0; i--) {
                int j = random.nextInt(i + 1);
                int tmp = activeMapping[i]; activeMapping[i] = activeMapping[j]; activeMapping[j] = tmp;
            }
        } else { for (int i = 0; i < 10; i++) activeMapping[i] = i; }
    }

    private double getRhythmDuration(int rhythmIndex, int index, double base) {
        switch (rhythmIndex) {
            case 1: return (index % 2 == 0) ? base * 1.5 : base * 0.5; // 摇摆
            case 2: return (index % 3 == 0) ? base * 1.5 : base * 0.75; // 圆舞曲
            case 3: return (index % 4 < 2) ? base * 1.2 : base * 0.6; // 探戈
            case 4: return base * 0.3; // 断奏
            case 5: // 致爱丽丝 (3/8拍子: 16分音符节奏感)
                double[] elise = {0.5, 0.5, 0.5, 0.5, 1.0, 1.0};
                return base * elise[index % elise.length];
            case 6: // 月光奏鸣曲 (3连音律动)
                return base * 0.66;
            case 7: // 土耳其进行曲 (快速16分音符)
                return (index % 4 == 3) ? base * 1.0 : base * 0.5;
            case 8: // 小夜曲 (轻快切分)
                double[] serenade = {1.2, 0.4, 0.4, 1.0};
                return base * serenade[index % serenade.length];
            case 9: // 天鹅湖 (附点节奏)
                return (index % 2 == 0) ? base * 1.5 : base * 0.5;
            case 10: // 卡农 (平稳的8分音符)
                return base * 1.0;
            case 11: // 命运 (三短一长)
                return (index % 4 == 3) ? base * 2.0 : base * 0.5;
            case 12: // 野蜂飞舞 (极速)
                return base * 0.2;
            case 13: // 梦幻曲 (舒缓长音)
                double[] reverie = {2.0, 1.0, 1.0, 2.0};
                return base * reverie[index % reverie.length];
            case 14: // 欢乐颂 (4/4正拍)
                return (index % 4 == 3) ? base * 1.5 : base * 1.0;
            case 15: return base * (0.3 + random.nextDouble() * 1.5); // 随机
            default: return base;
        }
    }

    private int getRhythmCycleLength(int rhythmIndex) {
        switch (rhythmIndex) {
            case 1: return 2; // 摇摆
            case 2: return 3; // 圆舞曲
            case 3: return 4; // 探戈
            case 5: return 6; // 致爱丽丝
            case 7:
            case 8:
            case 11:
            case 13:
            case 14: return 4;
            default: return 1; // 其他模式默认每音符判断一次
        }
    }

    // --- Pi File Reader ---

    private static class PiFileReader {
        private final Resources res;
        private long currentIndex = 0;
        private InputStream inputStream;
        private BufferedReader reader;
        private boolean headerSkipped = false;

        public PiFileReader(Resources res) { this.res = res; reset(); }

        public void reset() {
            try {
                if (inputStream != null) inputStream.close();
                inputStream = res.openRawResource(R.raw.pi);
                reader = new BufferedReader(new InputStreamReader(inputStream), 65536);
                currentIndex = 0;
                headerSkipped = false;
            } catch (IOException e) { Log.e(TAG, "File Reset Error", e); }
        }

        public int nextDigit() {
            try {
                if (!headerSkipped) skipHeader();
                while (true) {
                    int c = reader.read();
                    if (c == -1) return -1;
                    if (c == ':') { reader.readLine(); continue; }
                    if (Character.isDigit(c)) {
                        currentIndex++;
                        return Character.getNumericValue(c);
                    }
                }
            } catch (IOException e) { return -1; }
        }

        private void skipHeader() throws IOException {
            String line;
            while ((line = reader.readLine()) != null) {
                if (line.contains("Pi = 3.")) { headerSkipped = true; break; }
            }
        }

        public void jumpToIndex(long target) {
            reset();
            try {
                if (!headerSkipped) skipHeader();
                long count = 0;
                while (count < target) {
                    int c = reader.read();
                    if (c == -1) break;
                    if (c == ':') { reader.readLine(); continue; }
                    if (Character.isDigit(c)) count++;
                }
                currentIndex = count;
            } catch (IOException e) { Log.e(TAG, "Jump Error", e); }
        }

        public long getCurrentIndex() { return currentIndex; }
    }
